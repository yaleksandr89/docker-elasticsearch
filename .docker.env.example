# Название проекта
COMPOSE_PROJECT_NAME=docker-elasticsearch

# Версии
ELASTIC_VERSION=9.5.7
KIBANA_VERSION=9.5.7
NGINX_VERSION=1.30.8-trixie

# Имена контейнеров
ELASTIC_CONTAINER=docker-elasticsearch-es
KIBANA_CONTAINER=docker-elasticsearch-kibana
NGINX_CONTAINER=docker-elasticsearch-nginx

# Домены
KIBANA_DOMAIN=kibana.local
ELASTIC_DOMAIN=elastic.local

# Порты
KIBANA_PORT=5601
ELASTIC_PORT=9200
NGINX_PORT=8080

# Пути для данных
ELASTIC_DATA_DIR=./data/elasticsearch
KIBANA_DATA_DIR=./data/kibana

# Имя существующей доверенной сети для WITH_EXTERNAL_NETWORK=1
EXTERNAL_NETWORK=external_network
